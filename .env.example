POSTGRES_USER=postgres
POSTGRES_PASSWORD=replace-with-a-unique-local-password
POSTGRES_DB=app_db
DATABASE_URL=postgresql://postgres:replace-with-a-unique-local-password@localhost:5432/app_db
GROQ_API_KEY=
GROQ_MODEL=qwen/qwen3.8-27b

# If POSTGRES_PASSWORD contains URL-reserved characters, percent-encode it in
# DATABASE_URL (for example, @ becomes %40 and # becomes %23). Do not print URLs
# containing credentials into logs or commit the populated .env file.
